{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter Cloud Catalog (Debug)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "debug",
            "toolArgs": ["--dart-define=API_BASE_URL=${input:memberApiUrl}", "--dart-define=CLOUD_CATALOG=true"]
        },
        {
            "name": "Flutter Member API (Debug)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "debug",
            "toolArgs": ["--dart-define=API_BASE_URL=${input:memberApiUrl}"]
        },
        {
            "name": "Flutter Android Emulator (Debug)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "preLaunchTask": "Update project before Flutter launch",
            "deviceId": "emulator-5554",
            "flutterMode": "debug"
        },
        {
            "name": "Flutter Android Emulator (Release)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "preLaunchTask": "Update project before Flutter launch",
            "deviceId": "emulator-5554",
            "flutterMode": "release"
        }
    ],
    "inputs": [
        {
            "id": "memberApiUrl",
            "type": "promptString",
            "description": "Member API base URL (include /api)",
            "default": "http://10.0.2.2:3000/api"
        }
    ]
}
